# Copy to dev.env (gitignored) and fill in from the team credentials. Never commit dev.env.
# The practice arena passes only LLM_* and BOT_* variables to your bot (rule 14.3).
LLM_BASE_URL=<OpenAI-compatible gateway URL>
LLM_API_KEY=sk-...team dev key...
LLM_MODEL=haiku

# Not used by the bot; for your own scripts (docker login, practice page)
HARBOR_USER=<your registry user>
HARBOR_PASSWORD=...
PRACTICE_TOKEN=...
